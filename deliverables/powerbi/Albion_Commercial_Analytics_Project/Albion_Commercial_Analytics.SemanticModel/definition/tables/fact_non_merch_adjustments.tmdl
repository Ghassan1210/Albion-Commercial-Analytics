					Dates = Table.TransformColumns(Headers, {{"invoice_date", each if _ = null or Text.Trim(_) = "" then null else Date.FromText(Text.Start(Text.Trim(_), 10), "en-US"), type date}}),
					Typed = Table.TransformColumnTypes(Dates, {{"raw_row_id", type text}, {"source_sheet", type text}, {"invoice_no", type text}, {"stock_code", type text}, {"Description", type text}, {"quantity", type number}, {"invoice_date", type date}, {"unit_price", type number}, {"raw_signed_value", type number}, {"primary_audit_category", type text}, {"return_sign_subtype", type text}, {"customer_id", type text}, {"country", type text}})
