table fact_returns_and_cancellations
	lineageTag: 3490b427-a99c-4996-8894-b8d79650d8bb

	measure 'Cat04 Signed Returns GBP' = SUM(fact_returns_and_cancellations[raw_signed_value])
		formatString: £#,##0.00
		lineageTag: 44b97646-a8b6-464c-8d7f-dc62a60519b9

	measure 'Recorded Returns Magnitude GBP' = SUM(fact_returns_and_cancellations[abs_return_value])
		formatString: £#,##0.00
		lineageTag: 5e02e5c1-4b4c-4c95-99f9-1de4b9af4425

	measure 'Net Recorded Merchandise Value GBP' = [Positive Merchandise Sales GBP] + [Cat04 Signed Returns GBP]
		formatString: £#,##0.00
		lineageTag: 546b04eb-9fd3-45b2-ba38-efe3a07e6e93

	measure 'Merchandise Return Rate %' = DIVIDE([Recorded Returns Magnitude GBP], [Positive Merchandise Sales GBP], 0)
		formatString: 0.00%
		lineageTag: 8baee8d0-f0e1-486d-b90c-3271f9cc3e82

	measure 'Net Cancellation Impact %' = DIVIDE(-[Cat04 Signed Returns GBP], [Positive Merchandise Sales GBP], 0)
		formatString: 0.00%
		lineageTag: 2a33916c-2fef-40c6-832f-056affc0f625

