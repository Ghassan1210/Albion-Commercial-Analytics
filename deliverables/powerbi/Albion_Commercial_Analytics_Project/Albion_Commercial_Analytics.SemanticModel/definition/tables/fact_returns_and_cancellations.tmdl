	partition fact_returns_and_cancellations = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\\Important GHN files\\GHN12\\deliverables\\powerbi\\data_model_exports\\fact_returns_and_cancellations.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Dates = Table.TransformColumns(Headers, {{"invoice_date", each if _ = null or Text.Trim(_) = "" then null else Date.FromText(Text.Start(Text.Trim(_), 10), "en-US"), type date}}),
					Typed = Table.TransformColumnTypes(Dates, {{"raw_row_id", type text}, {"source_sheet", type text}, {"invoice_no", type text}, {"stock_code", type text}, {"Description", type text}, {"quantity", type number}, {"invoice_date", type date}, {"unit_price", type number}, {"raw_signed_value", type number}, {"return_sign_subtype", type text}, {"abs_return_value", type number}, {"customer_id", type text}, {"country", type text}})
				in Typed

	annotation PBI_ResultType = Table

