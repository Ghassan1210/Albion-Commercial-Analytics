table fact_merchandise_sales
	lineageTag: f7501bfa-2792-418c-816d-a97d9b74e496

	measure 'Positive Merchandise Sales GBP' = SUM(fact_merchandise_sales[raw_signed_value])
		formatString: £#,##0.00
		lineageTag: 9110104c-9061-4c2a-abf2-d4eab5c74b74

	measure 'Identified Customer Revenue GBP' = CALCULATE([Positive Merchandise Sales GBP], fact_merchandise_sales[customer_id] <> "UNIDENTIFIED" && NOT ISBLANK(fact_merchandise_sales[customer_id]))
		formatString: £#,##0.00
		lineageTag: 0150a84e-8202-4d3d-929b-dfbec6cad3e1

	measure 'Anonymous Guest Revenue GBP' = CALCULATE([Positive Merchandise Sales GBP], fact_merchandise_sales[customer_id] = "UNIDENTIFIED")
		formatString: £#,##0.00
		lineageTag: 41db416b-1e1c-4985-a2b7-089c25cf26b3

	measure 'Average Order Value GBP' = DIVIDE([Positive Merchandise Sales GBP], DISTINCTCOUNT(fact_merchandise_sales[invoice_no]), 0)
		formatString: £#,##0.00
		lineageTag: 978aa39f-73da-4841-aa72-7bbf2b929b13

	measure 'Sales LY' = CALCULATE([Positive Merchandise Sales GBP], SAMEPERIODLASTYEAR(dim_date[date]))
		formatString: £#,##0.00
		lineageTag: 55dd71b1-5171-4b16-a9c2-054f795a9a55

	measure 'YoY Sales %' = DIVIDE([Positive Merchandise Sales GBP] - [Sales LY], [Sales LY], 0)
		formatString: 0.00%
		lineageTag: 8af75cff-b1d3-463c-857e-6df1ff828130

